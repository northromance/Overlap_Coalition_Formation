clear; clc;
feature('DefaultCharacterSet', 'UTF-8');

%% =========================================================================
%  实验 A：变 N 规模（对应图1a / 图1b / 图2c / 图3）
%
%  本脚本的核心用途：
%  1) 固定任务数 M=10、资源种类 K=6
%  2) 遍历不同的智能体数量 N（例如 N=4,6,8,10...）
%  3) 对多个算法在相同场景下进行批量重复实验（不同随机种子）
%  4) 汇总每个算法的结果，并保存到 .mat 文件
%
%  重要说明：
%  - 本脚本“主要负责跑实验 + 存结果”，而不是直接画图
%  - 后续画图脚本通常会读取这里保存的 .mat 数据来画图
%  - 本脚本会额外保存第 INNER_LOOP_ROUND 轮的内循环轨迹，用于图3
%% =========================================================================

%% ===== 批量实验配置 =====
% SEEDS：随机种子序列
% 不同 seed 表示不同随机场景，用来做重复实验、取均值、增强结果稳健性
SEEDS = 1001:1:1006;                 % 测试用；正式运行可改成 1001:1:1020

% N_VALUES：要测试的不同智能体规模 N
% 即“变 N”实验的横坐标候选值
% N_VALUES = [4, 6, 8, 10, 12, 16, 20];  % 正式运行建议用这组
N_VALUES = [4, 6, 8, 10];            % 当前是测试用小规模

% 固定任务数 M、固定资源种类数 K
M = 10;                              % 任务数（固定）
K = 6;                               % 资源种类数（固定）

% 要运行的算法 ID
% 2 -> Huo2025
% 3 -> Qi2023
% 4 -> Shi2024
% 7 -> OCF_SAtabu
algorithms_to_run_ids = [2, 3, 4, 7];

% 保存哪一轮“外循环”的内循环轨迹
% 例如设为 50，则优先保存第 50 轮外循环对应的内层搜索过程
% 若历史轮数不足 50，则退化为保存“最后一轮”的内循环轨迹
INNER_LOOP_ROUND = 50;

%% ===== 附加控制参数 AddPara =====
% verbose:
%   是否打印更多算法内部信息
%   0 = 不打印，1 = 打印
AddPara.verbose = 1;

% enable_belief_update:
%   是否启用 belief update（信念更新）
%   这个参数是否真正生效，取决于你的算法内部实现
AddPara.enable_belief_update = true;

% control:
%   控制模式参数，具体含义要看你各算法主函数内部如何解释
% AddPara.control = 1;

%% ===== 通用超参数 =====
% num_rounds:
%   外循环轮数
%   每个算法会进行 num_rounds 轮大的迭代/博弈/重构
num_rounds = 3;                      % 测试用；正式运行建议改成 100

% MaxIter:
%   每轮外循环内部允许的最大内层迭代次数
MaxIter = 50;

% obs_times:
%   某些效用/观测统计的相关参数，具体作用看 OCFUtils.init_value_params
obs_times = 50;

% task_values:
%   三类任务的任务价值
%   type=1 对应 800
%   type=2 对应 1000
%   type=3 对应 1500
task_values = [800, 1000, 1500];

% 任务类型数量
num_task_types = length(task_values);

%% ===== 模拟退火 / 禁忌搜索 / 各算法通用参数 =====
T0_round            = 100;   % 初始温度（或轮级温度参数）
SA_alpha            = 0.9;   % 模拟退火参数
SA_Tmin             = 0.01;  % 模拟退火最低温度
T_decay             = 0.8;   % 温度衰减系数
T_min_round         = 2;     % 最低温度开始控制的轮次
T_init_construction = 2;     % 初始构造相关参数
resource_confidence = 0.7;   % 资源置信度参数
K_stable_max        = 10;    % 稳定判定最大计数
tabu_tenure         = 20;    % 禁忌长度
p_leave             = 0.3;   % 离开/撤出概率参数

% Qi2023 相关参数
Qi_L_tabu        = 10;
Qi_K_stable_max  = 10;
Qi_Gamma_init    = 1;
Qi_Gamma_max     = 50;

% Shi2024 相关参数
Shi_K_stable_max = 10;

%% ===== 场景参数：世界范围、智能体参数、任务资源参数 =====
% 世界范围（二维平面）
WORLD_XMIN = 0;  WORLD_XMAX = 100;
WORLD_YMIN = 0;  WORLD_YMAX = 100;
WORLD_ZMIN = 0;  WORLD_ZMAX = 0;     % 这里 Z 被固定为 0，相当于二维场景

% 智能体基础属性
agent_velocity    = 2;      % 智能体速度
agent_detprob_min = 0.95;   % 感知/探测概率最小值
agent_detprob_max = 1.0;    % 感知/探测概率最大值
agent_Emax_min    = 300;    % 最大能量下限
agent_Emax_range  = 50;     % 最大能量随机浮动范围
agent_fuel        = 1;      % 行动燃料/消耗参数
agent_wait_fuel   = 0.5;    % 等待燃料/等待消耗参数
agent_beta        = 1;      % 代价/偏好/权重参数（具体看算法内部）

% 智能体资源向量的取值范围
min_resource_value = 0;
max_resource_value = 4;

% 不同任务类型对资源需求的最大值
task_type1_demand_max = 4;
task_type2_demand_max = 6;
task_type3_demand_max = 8;

% 每类资源的执行时间
% 例如第 1 类资源执行时间为 50，第 2 类为 65 ...
resource_exec_time = [50 65 50 60 35 45];

%% ===== 路径初始化 =====
% 当前脚本位于 experiments/ 子目录
% root_dir 指向项目根目录
script_dir = fileparts(mfilename('fullpath'));
root_dir   = fileparts(script_dir);

% 将主函数和各算法目录加入 MATLAB 路径
addpath(fullfile(root_dir, 'Main_fun'));
addpath(fullfile(root_dir, 'comalg', 'alg1_SA'));
addpath(fullfile(root_dir, 'comalg', 'alg2_Huo2025'));
addpath(fullfile(root_dir, 'comalg', 'alg3_Qi2023'));
addpath(fullfile(root_dir, 'comalg', 'alg4_Shi2024'));
addpath(fullfile(root_dir, 'comalg', 'alg7_OCF_SAtabu'));

%% ===== 输出目录 =====
% 所有批量实验结果会保存到 results/batch/varyN/ 目录下
results_dir = fullfile(root_dir, 'results', 'batch', 'varyN');
if ~exist(results_dir, 'dir')
    mkdir(results_dir);
end

%% ===== 算法注册表 =====
% 这里建立一个“算法列表”，每个元素包含：
%   id   : 算法编号
%   name : 算法名称（后续作为结构体字段名）
%   func : 对应的主函数句柄
all_algorithms = {
    struct('id', 2, 'name', 'Huo2025',    'func', @Huo2025_main);
    struct('id', 3, 'name', 'Qi2023',     'func', @Qi2023_main);
    struct('id', 4, 'name', 'Shi2024',    'func', @Shi2024_main);
    struct('id', 7, 'name', 'OCF_SAtabu', 'func', @OCF_SAtabu_global_main);
};

% 根据 algorithms_to_run_ids 筛选出本次真正要跑的算法
enabled_algorithms = {};
for i = 1:length(all_algorithms)
    if ismember(all_algorithms{i}.id, algorithms_to_run_ids)
        enabled_algorithms{end+1} = all_algorithms{i}; %#ok<SAGROW>
    end
end

% 实际运行算法数
num_algs = length(enabled_algorithms);

% 取出算法名称列表，例如 {'Huo2025','Qi2023','Shi2024','OCF_SAtabu'}
alg_names = cellfun(@(a) a.name, enabled_algorithms, 'UniformOutput', false);

%% ===== 进度计数 =====
% 总实验数 = N 的个数 × seed 的个数
total_runs = length(N_VALUES) * length(SEEDS);

% 当前已完成次数
done = 0;

% 总耗时计时器
total_tic = tic;
total_runs = length(N_VALUES) * length(SEEDS);   % 场景数
total_alg_runs = total_runs * num_algs;          % 算法总运行次数

fprintf('\n');
fprintf('========================================================================\n');
fprintf('  Batch_VaryN  |  场景数 N×S = %d×%d = %d\n', ...
    length(N_VALUES), length(SEEDS), total_runs);
fprintf('  算法数       = %d\n', num_algs);
fprintf('  总算法运行数 = %d × %d = %d\n', total_runs, num_algs, total_alg_runs);
fprintf('  N_VALUES = [%s]\n', num2str(N_VALUES));
fprintf('  SEEDS    = %d : %d\n', SEEDS(1), SEEDS(end));
fprintf('  算法     = [%s]\n', strjoin(alg_names, ', '));
fprintf('  轮数     = %d   内层迭代 = %d   内循环保存轮次 = %d\n', ...
    num_rounds, MaxIter, INNER_LOOP_ROUND);
fprintf('========================================================================\n\n');
fprintf('\n');
fprintf('========================================================================\n');
fprintf('  Batch_VaryN  |  N×S = %d×%d = %d 次实验\n', ...
    length(N_VALUES), length(SEEDS), total_runs);
fprintf('  N_VALUES = [%s]\n', num2str(N_VALUES));
fprintf('  SEEDS    = %d : %d\n', SEEDS(1), SEEDS(end));
fprintf('  算法     = [%s]\n', strjoin(alg_names, ', '));
fprintf('  轮数     = %d   内层迭代 = %d   内循环保存轮次 = %d\n', ...
    num_rounds, MaxIter, INNER_LOOP_ROUND);
fprintf('  总运行次数   = N×S×A = %d×%d×%d = %d\n', ...
    length(N_VALUES), length(SEEDS), num_algs, total_alg_runs);
fprintf('========================================================================\n\n');

%% ===== 结果容器 =====
% scale_N_results 是一个 cell 数组，大小为：
%   [length(N_VALUES), length(SEEDS)]
%
% 其中：
%   scale_N_results{ni, si}
% 表示：
%   第 ni 个 N 值、 第 si 个随机种子 对应的一次完整实验结果
scale_N_results = cell(length(N_VALUES), length(SEEDS));

%% =========================================================================
%  主循环：先遍历 N，再遍历 seed
%% =========================================================================
for ni = 1:length(N_VALUES)
    N = N_VALUES(ni);   % 当前实验的智能体数量

    for si = 1:length(SEEDS)
        seed = SEEDS(si);  % 当前实验的随机种子

        % 更新整体进度
        done = done + 1;
        elapsed = toc(total_tic);

        % 估算剩余时间 ETA
        eta_str = '';
        if done > 1
            avg_per_run = elapsed / (done - 1);
            eta_sec     = avg_per_run * (total_runs - done + 1);
            eta_str     = sprintf('  ETA %.0fs', eta_sec);
        end

        fprintf('[%3d/%3d] N=%2d seed=%d ...%s\n', ...
            done, total_runs, N, seed, eta_str);

        %% ===== 初始化本次场景结果 entry =====
        % entry 表示“某个 N + 某个 seed”的整体结果
        entry = struct();
        entry.N       = N;          % 当前智能体规模
        entry.seed    = seed;       % 当前随机种子
        entry.success = false;      % 整个场景是否成功
        entry.error   = '';         % 场景级报错信息
        entry.algs    = struct();   % 存放各算法结果

        try
            %% =============================================================
            %  1) 构建随机场景
            %% =============================================================
            % 重置随机数状态，并使用当前 seed 保证可重复性
            rng('default');
            rng(seed);

            % 世界信息
            WORLD = struct();
            WORLD.XMIN  = WORLD_XMIN;
            WORLD.XMAX  = WORLD_XMAX;
            WORLD.YMIN  = WORLD_YMIN;
            WORLD.YMAX  = WORLD_YMAX;
            WORLD.ZMIN  = WORLD_ZMIN;
            WORLD.ZMAX  = WORLD_ZMAX;
            WORLD.value = task_values;

            %% -- 生成“任务类型 -> 资源需求”模板 --
            % task_type_demands(t, k) 表示：
            %   第 t 类任务对第 k 类资源的需求量
            %
            % 这是一个 num_task_types × K 的矩阵
            task_type_demands = zeros(num_task_types, K);
            task_type_demands(1, :) = randi([0, task_type1_demand_max], 1, K);
            task_type_demands(2, :) = randi([0, task_type2_demand_max], 1, K);
            task_type_demands(3, :) = randi([0, task_type3_demand_max], 1, K);

            %% -- 生成“任务类型 -> 各资源执行时长”模板 --
            % task_type_duration_by_resource(t, k) 表示：
            %   第 t 类任务若需要第 k 类资源，则该资源执行所需时间
            %   若该类任务不需要该资源，则该值为 0
            task_type_duration_by_resource = zeros(num_task_types, K);
            for t = 1:num_task_types
                needed = task_type_demands(t, :) > 0;  % 需要该资源的位置
                task_type_duration_by_resource(t, needed) = resource_exec_time(needed);
            end

            %% -- 生成具体任务列表 tasks --
            % tasks(j) 表示第 j 个任务
            %
            % 每个任务字段含义：
            %   id                   : 任务编号
            %   priority             : 任务优先级（这里是随机排列）
            %   x, y                 : 任务空间坐标
            %   type                 : 任务类型（1/2/3）
            %   value                : 任务价值
            %   resource_demand      : K维资源需求向量
            %   duration_by_resource : 每类资源对应执行时间
            %   duration             : 任务总持续时间（取最大资源执行时间）
            %   WORLD                : 世界信息
            tasks = struct();
            task_priorities = randperm(M);  % 随机优先级

            for j = 1:M
                tasks(j).id       = j;
                tasks(j).priority = task_priorities(j);

                % 随机生成任务坐标
                tasks(j).x = round(rand() * (WORLD.XMAX - WORLD.XMIN) + WORLD.XMIN);
                tasks(j).y = round(rand() * (WORLD.YMAX - WORLD.YMIN) + WORLD.YMIN);

                % 随机任务类型
                tasks(j).type = randi(num_task_types, 1, 1);

                % 根据任务类型映射任务价值
                tasks(j).value = WORLD.value(tasks(j).type);

                % 根据任务类型，取对应资源需求模板
                tasks(j).resource_demand = task_type_demands(tasks(j).type, :);

                % 根据任务类型，取对应资源执行时长模板
                tasks(j).duration_by_resource = ...
                    task_type_duration_by_resource(tasks(j).type, :);

                % 任务总持续时间：这里定义为所需资源执行时长中的最大值
                tasks(j).duration = max(tasks(j).duration_by_resource);

                % 保存世界信息
                tasks(j).WORLD = WORLD;
            end

            %% -- 生成具体智能体列表 agents --
            % agents(i) 表示第 i 个智能体
            %
            % 每个智能体字段含义：
            %   id        : 智能体编号
            %   vel       : 速度
            %   x, y      : 初始位置
            %   detprob   : 探测/感知概率
            %   resources : K维资源能力向量
            %   Emax      : 最大能量
            %   fuel      : 行动消耗参数
            %   wait_fuel : 等待消耗参数
            %   beta      : 权重/偏好参数
            agents = struct();

            for i = 1:N
                agents(i).id  = i;
                agents(i).vel = agent_velocity;

                % 随机初始位置
                agents(i).x = round(rand() * (WORLD.XMAX - WORLD.XMIN) + WORLD_XMIN);
                agents(i).y = round(rand() * (WORLD.YMAX - WORLD_YMIN) + WORLD_YMIN);

                % 随机感知概率
                agents(i).detprob = ...
                    agent_detprob_min + (agent_detprob_max - agent_detprob_min) * rand();

                % K维资源能力向量，每个维度在 [min_resource_value, max_resource_value] 内随机
                agents(i).resources = randi([min_resource_value, max_resource_value], K, 1);

                % 最大能量
                agents(i).Emax = agent_Emax_min + agent_Emax_range * rand();

                % 其余控制参数
                agents(i).fuel      = agent_fuel;
                agents(i).wait_fuel = agent_wait_fuel;
                agents(i).beta      = agent_beta;
            end

            %% -- 构建 Value_Params --
            % Value_Params 是给各算法传入的统一参数结构体
            % 里面汇总了任务规模、资源需求、迭代参数、禁忌参数等
            Value_Params = OCFUtils.init_value_params( ...
                N, M, K, num_task_types, task_type_demands, ...
                SA_alpha, SA_Tmin, K_stable_max, obs_times, num_rounds);

            Value_Params.K_stable_max        = K_stable_max;
            Value_Params.max_inner_iter      = MaxIter;
            Value_Params.T0_round            = T0_round;
            Value_Params.T_decay             = T_decay;
            Value_Params.T_min_round         = T_min_round;
            Value_Params.resource_confidence = resource_confidence;
            Value_Params.T_init_construction = T_init_construction;
            Value_Params.tabu_tenure         = tabu_tenure;
            Value_Params.p_leave             = p_leave;
            Value_Params.Qi_L_tabu           = Qi_L_tabu;
            Value_Params.Qi_K_stable_max     = Qi_K_stable_max;
            Value_Params.Qi_Gamma_init       = Qi_Gamma_init;
            Value_Params.Qi_Gamma_max        = Qi_Gamma_max;
            Value_Params.Shi_K_stable_max    = Shi_K_stable_max;
            Value_Params.C                   = 2000;
            Value_Params.seed                = seed;

            %% =============================================================
            %  2) 运行所有启用算法
            %% =============================================================
            for ai = 1:num_algs
                alg   = enabled_algorithms{ai};
                aname = alg.name;

                % 为当前算法初始化结果结构体
                alg_entry = struct();

                % 1. 算法运行耗时（秒）
                alg_entry.computation_time = NaN;

                % 2. 外循环收敛曲线：每轮一个值
                alg_entry.convergence_utility    = nan(num_rounds, 1); % 每轮联盟效用
                alg_entry.convergence_cost       = nan(num_rounds, 1); % 每轮全局成本
                alg_entry.convergence_completion = nan(num_rounds, 1); % 每轮平均任务完成度

                % 3. 最终结果：最后一轮的值
                alg_entry.final_utility    = NaN;
                alg_entry.final_cost       = NaN;
                alg_entry.final_completion = NaN;

                % 4. 第 INNER_LOOP_ROUND 轮的内循环轨迹
                %    注意：结构内部字段长什么样，取决于 alg.func 返回的 history_data.inner_loop{r}
                alg_entry.inner_loop_r50 = struct();

                % 5. 算法运行状态
                alg_entry.success = false;
                alg_entry.error   = '';

                try
                    % 为保证不同算法在相同场景下尽量使用相同随机起点，这里再次设置 seed
                    rng(seed);

                    % 计时开始
                    tic;

                    % 执行算法主函数
                    % 第一个输出通常是当前解/最终解
                    % 第二个输出 history_data 保存全过程历史
                    [~, history_data] = alg.func(agents, tasks, AddPara, Value_Params);

                    % 记录耗时
                    alg_entry.computation_time = toc;

                    %% -- 从 history_data.rounds 提取外循环曲线 --
                    % history_data.rounds(r) 一般表示第 r 轮外循环的结果
                    % 这里抽取三个指标：
                    %   coalition_utility      -> 联盟效用
                    %   total_global_cost      -> 全局成本
                    %   task_completion_degrees -> 各任务完成度，再取均值
                    num_r = length(history_data.rounds);

                    for r = 1:num_r
                        alg_entry.convergence_utility(r) = ...
                            history_data.rounds(r).coalition_utility;

                        alg_entry.convergence_cost(r) = ...
                            history_data.rounds(r).total_global_cost;

                        td = history_data.rounds(r).task_completion_degrees; % 任务完成率
                        alg_entry.convergence_completion(r) = mean(td);
                    end

                    %% -- 取最后一轮作为最终结果 --
                    alg_entry.final_utility    = alg_entry.convergence_utility(num_r);
                    alg_entry.final_cost       = alg_entry.convergence_cost(num_r);
                    alg_entry.final_completion = alg_entry.convergence_completion(num_r);

                    %% -- 提取指定轮次的内循环轨迹，用于后续画图3 --
                    % 优先保存第 INNER_LOOP_ROUND 轮
                    % 若该轮不存在，则保存最后一轮内循环轨迹
                    if isfield(history_data, 'inner_loop') && ...
                            length(history_data.inner_loop) >= INNER_LOOP_ROUND && ...
                            ~isempty(history_data.inner_loop{INNER_LOOP_ROUND})

                        alg_entry.inner_loop_r50 = history_data.inner_loop{INNER_LOOP_ROUND};

                    elseif isfield(history_data, 'inner_loop') && ...
                            ~isempty(history_data.inner_loop)

                        last_r = length(history_data.inner_loop);
                        alg_entry.inner_loop_r50 = history_data.inner_loop{last_r};
                    end

                    % 算法成功完成
                    alg_entry.success = true;

                catch ME_alg
                    % 某个算法单独失败，不影响同一场景下其他算法继续跑
                    alg_entry.error = ME_alg.message;
                    fprintf('  ! %s failed: %s\n', aname, ME_alg.message);
                end

                % 将当前算法结果挂到 entry.algs 下
                % 例如：
                %   entry.algs.Huo2025
                %   entry.algs.Qi2023
                %   entry.algs.Shi2024
                %   entry.algs.OCF_SAtabu
                entry.algs.(aname) = alg_entry;
            end

            % 如果整个场景成功构建且循环正常结束，则标记场景成功
            entry.success = true;

        catch ME_outer
            % 如果场景生成本身出错，则整个 N + seed 失败
            entry.error = ME_outer.message;
            fprintf('  ! scenario N=%d seed=%d failed: %s\n', N, seed, ME_outer.message);
        end

        % 保存本次场景结果到总 cell 容器
        scale_N_results{ni, si} = entry;
    end % seeds
end % N_VALUES

%% ===== 全部实验完成后的耗时统计 =====
total_elapsed = toc(total_tic);
fprintf('\n全部完成，总耗时 %.1f s (%.1f min)\n', ...
    total_elapsed, total_elapsed / 60);

%% =========================================================================
%  3) 组织最终要保存的配置数据 scale_config
%% =========================================================================
% 命名格式：
%   N{min}-{max}_M{M}_K{K}_S{nSeeds}_{timestamp}.mat
%
% 注意：
%   当前脚本最终仅保存：
%     1) scale_N_results
%     2) scale_config
%
%   也就是说：
%     tasks / agents / Value_Params / task_type_demands 等
%   虽然运行中都生成了，但当前版本“没有直接保存进 mat 文件”
%% =========================================================================

scale_config = struct();
scale_config.N_values         = N_VALUES;                     % 遍历的 N 列表
scale_config.M                = M;                            % 固定任务数
scale_config.K                = K;                            % 固定资源种类数
scale_config.seeds            = SEEDS;                        % 使用的随机种子
scale_config.alg_ids          = algorithms_to_run_ids;        % 参与实验的算法 ID
scale_config.alg_names        = alg_names;                    % 参与实验的算法名称
scale_config.num_rounds       = num_rounds;                   % 外循环轮数
scale_config.max_inner_iter   = MaxIter;                      % 内层最大迭代次数
scale_config.inner_loop_round = INNER_LOOP_ROUND;             % 保存哪一轮的内循环轨迹
scale_config.timestamp        = datestr(now, 'yyyymmdd_HHMMSS'); % 保存时间戳

timestamp = scale_config.timestamp;

filename = fullfile(results_dir, sprintf('N%d-%d_M%d_K%d_S%d_%s.mat', ...
    N_VALUES(1), N_VALUES(end), M, K, length(SEEDS), timestamp));

%% =========================================================================
%  保存字段说明（重点）
%
%  一、scale_N_results 的结构
%  -------------------------------------------------------------------------
%  scale_N_results{ni, si}
%    = 第 ni 个 N_VALUES、 第 si 个 SEEDS 对应的一次实验结果 entry
%
%  entry 包含：
%    entry.N
%      - 当前实验的智能体数量 N
%
%    entry.seed
%      - 当前实验的随机种子
%
%    entry.success
%      - 当前场景是否成功完成
%      - true  表示场景层面成功
%      - false 表示场景生成或整体流程出错
%
%    entry.error
%      - 场景级错误信息
%
%    entry.algs
%      - 各算法结果的结构体集合
%      - 例如 entry.algs.Huo2025
%
%  -------------------------------------------------------------------------
%  entry.algs.(算法名) = alg_entry
%
%  alg_entry 包含：
%
%    alg_entry.computation_time
%      - 该算法在当前场景下的运行耗时（秒）
%
%    alg_entry.convergence_utility
%      - 外循环每一轮的联盟效用
%      - 可用于画“效用-轮次”收敛曲线
%
%    alg_entry.convergence_cost
%      - 外循环每一轮的全局成本
%      - 可用于画“成本-轮次”收敛曲线
%
%    alg_entry.convergence_completion
%      - 外循环每一轮的平均任务完成度
%      - 由 task_completion_degrees 取均值得到
%      - 可用于画“完成度-轮次”收敛曲线
%
%    alg_entry.final_utility
%      - 最后一轮的联盟效用
%      - 常用于画“最终效用 vs N”的图（如图1a）
%
%    alg_entry.final_cost
%      - 最后一轮的全局成本
%      - 常用于画“最终成本 vs N”的图（如图1b）
%
%    alg_entry.final_completion
%      - 最后一轮的平均任务完成度
%      - 常用于画“最终完成度 vs N”的图（如图2c）
%
%    alg_entry.inner_loop_r50
%      - 第 INNER_LOOP_ROUND 轮对应的内循环轨迹
%      - 若第 INNER_LOOP_ROUND 轮不存在，则保存最后一轮内循环轨迹
%      - 常用于画图3
%
%    alg_entry.success
%      - 当前算法在该场景下是否成功运行
%
%    alg_entry.error
%      - 当前算法失败时的报错信息
%
%  二、scale_config 的结构
%  -------------------------------------------------------------------------
%    scale_config.N_values
%      - 本次实验遍历的 N 列表
%
%    scale_config.M
%      - 固定任务数
%
%    scale_config.K
%      - 固定资源种类数
%
%    scale_config.seeds
%      - 本次实验使用的种子列表
%
%    scale_config.alg_ids
%      - 本次参与实验的算法 ID
%
%    scale_config.alg_names
%      - 本次参与实验的算法名称
%
%    scale_config.num_rounds
%      - 外循环轮数
%
%    scale_config.max_inner_iter
%      - 每轮外循环允许的最大内层迭代数
%
%    scale_config.inner_loop_round
%      - 希望保存哪一轮外循环的内循环轨迹
%
%    scale_config.timestamp
%      - 本次保存的时间戳
%% =========================================================================

fprintf('保存至: %s\n', filename);

% 最终只保存这两个变量
save(filename, 'scale_N_results', 'scale_config', '-v7.3');

fprintf('保存完成。\n\n');

%% =========================================================================
%  4) 快速完整性检查
%
%  检查有多少个场景成功、有多少个失败
%% =========================================================================
fprintf('--- 完整性检查 ---\n');

success_count = 0;
fail_count    = 0;

for ni2 = 1:length(N_VALUES)
    for si2 = 1:length(SEEDS)
        e = scale_N_results{ni2, si2};

        if e.success
            success_count = success_count + 1;
        else
            fail_count = fail_count + 1;
            fprintf('  FAIL: N=%d seed=%d  %s\n', e.N, e.seed, e.error);
        end
    end
end

fprintf('成功: %d / %d  失败: %d\n', success_count, total_runs, fail_count);

%% =========================================================================
%  5) 打印“各算法最终效用均值（按 N 规模）”
%
%  作用：
%  - 对每个 N
%  - 收集该 N 下所有 seed 的 final_utility
%  - 计算均值并打印
%
%  注意：
%  - 这里只打印 final_utility 的均值
%  - 没有打印 final_cost / final_completion 的均值
%  - 这部分只是屏幕输出，不会额外保存成新变量
%% =========================================================================
fprintf('\n--- 各算法最终效用均值（按 N 规模）---\n');

header = sprintf('%-6s', 'N');
for ai = 1:num_algs
    header = [header, sprintf(' | %-15s', alg_names{ai})]; %#ok<AGROW>
end
fprintf('%s\n', header);
fprintf('%s\n', repmat('-', 1, 6 + num_algs * 18));

for ni2 = 1:length(N_VALUES)
    row = sprintf('%-6d', N_VALUES(ni2));

    for ai = 1:num_algs
        aname = alg_names{ai};

        % 收集当前 N、当前算法、所有 seeds 的最终效用
        vals = zeros(1, length(SEEDS));

        for si2 = 1:length(SEEDS)
            e = scale_N_results{ni2, si2};

            if e.success && isfield(e.algs, aname) && e.algs.(aname).success
                vals(si2) = e.algs.(aname).final_utility;
            else
                vals(si2) = NaN;
            end
        end

        % 忽略 NaN 后求均值
        mu = mean(vals(~isnan(vals)));

        if isnan(mu)
            row = [row, sprintf(' | %-15s', 'N/A')]; %#ok<AGROW>
        else
            row = [row, sprintf(' | %-15.2f', mu)]; %#ok<AGROW>
        end
    end

    fprintf('%s\n', row);
end

fprintf('\n');