function deltaU = overlap_coalition_utility(tasks, agents, SC_P, SC_Q, agentID, Value_Params, Value_data)
% OVERLAP_COALITION_UTILITY 计算智能体在两个联盟结构间的效用差值 (偏好函数)
%
% 核心逻辑:
%   计算 deltaU = LHS - RHS
%   该公式通常用于帕累托改进或特定的享乐博弈(Hedonic Game)稳定性条件检查。
%   它衡量了：
%   1. 智能体自身的效用变化。
%   2. 智能体移动对"新加入"任务中原有成员的边际影响。
%   3. 智能体移动对"离开"任务中剩余成员的边际影响。
%   4. 智能体所有合作伙伴的总效用水平。
%
% 输入:
%   tasks        - 任务结构体数组
%   agents       - 智能体结构体数组
%   SC_P         - 当前/旧的联盟结构 (资源分配矩阵 Cell 数组)
%   SC_Q         - 提议/新的联盟结构 (资源分配矩阵 Cell 数组)
%   agentID      - 当前进行决策的智能体 ID
%   Value_Params - 全局参数 (包含 M, N 等)
%   Value_data   - 智能体的数据 (包含信念 belief 等，用于估算他人的效用)
%
% 输出:
%   deltaU       - 效用差值。若 > 0，表示倾向于切换到 SC_Q。

    M = Value_Params.M; % 任务数量
    N = Value_Params.N; % 智能体数量
    
    %% 1. 获取智能体参与的任务列表
    % 遍历 Cell 数组，查找 SC_Q 中 agentID 资源投入 > 0 的任务索引
    rows_n_Q = find(cellfun(@(x) any(x(agentID, :) > 0), SC_Q));
    % 查找 SC_P 中 agentID 资源投入 > 0 的任务索引
    rows_n_P = find(cellfun(@(x) any(x(agentID, :) > 0), SC_P));
    
    %% 2. 计算智能体自身的总效用 (Self Utility)
    % u_n_Q: 智能体 n 在新结构 Q 下，从它参与的所有任务中获得的总效用
    % 对于输入给定的联盟SC 求得输出
    u_n_Q = compute_vality(SC_Q, agents, tasks, Value_Params, Value_data);
    % u_n_P: 智能体 n 在旧结构 P 下，从它参与的所有任务中获得的总效用
    u_n_P = sum_utility(agentID, rows_n_P, SC_P, agents, tasks, Value_Params, Value_data.initbelief);
    
    %% 3. 计算 LHS 第二项：对"新加入"任务中其他成员的影响
    % 找出智能体 n 新加入的任务 (在 Q 中有，在 P 中没有)
    new_tasks = setdiff(rows_n_Q, rows_n_P);
    sum_new_delta = 0;
    
    for idx = 1:length(new_tasks)
        A_j = new_tasks(idx); % 任务 ID
        
        % 获取该任务在 Q 结构中的所有成员
        members = get_members(SC_Q, A_j, N);
        % 排除自己，只计算对他人的影响
        members(members == agentID) = [];
        
        for k = 1:length(members)
            g = members(k); % 成员 g
            % 计算成员 g 因 n 的加入产生的效用增量 (Q - P)
            % 注意：这里使用了 n 对 g 的信念 (Value_data.other{g}.initbelief) 来估算 g 的效用
            util_Q = overlap_coalition_self_utility(g, A_j, SC_Q, agents, tasks, Value_Params, Value_data.other{g}.initbelief);
            util_P = overlap_coalition_self_utility(g, A_j, SC_P, agents, tasks, Value_Params, Value_data.other{g}.initbelief);
            sum_new_delta = sum_new_delta + (util_Q - util_P);
        end
    end
    
    %% 4. 计算 RHS 第二项：对"离开"任务中剩余成员的影响
    % 找出智能体 n 离开的任务 (在 P 中有，在 Q 中没有)
    source_tasks = setdiff(rows_n_P, rows_n_Q);
    sum_source_delta = 0;
    
    for idx = 1:length(source_tasks)
        A_i = source_tasks(idx); % 任务 ID
        
        % 获取该任务在 P 结构中的所有成员 (即原来的队友)
        members = get_members(SC_P, A_i, N);
        members(members == agentID) = []; % 排除自己
        
        for k = 1:length(members)
            h = members(k); % 成员 h
            % 计算成员 h 因 n 的离开产生的效用损失 (P - Q)
            % 这里的逻辑是计算 P 相对于 Q 的优势，或者是 Q 相对于 P 的劣势
            util_P = overlap_coalition_self_utility(h, A_i, SC_P, agents, tasks, Value_Params, Value_data.other{h}.initbelief);
            util_Q = overlap_coalition_self_utility(h, A_i, SC_Q, agents, tasks, Value_Params, Value_data.other{h}.initbelief);
            sum_source_delta = sum_source_delta + (util_P - util_Q);
        end
    end
    
    %% 5. 确定智能体 n 的"合作伙伴集" (Neighborhood)
    % 构造 Mem(A(n))：在结构 Q 中，与 n 共同参与任意任务的所有成员的并集
    all_members_An = [];
    for idx = 1:length(rows_n_Q)
        % 取并集，收集所有任务的队友
        all_members_An = union(all_members_An, get_members(SC_Q, rows_n_Q(idx), N));
    end
    % 排除自己
    all_members_An(all_members_An == agentID) = [];
    
    %% 6. 计算 LHS/RHS 第三项：合作伙伴的总效用
    % 这一步比较的是：在 n 的新朋友圈 (Q中的队友) 眼里，Q 结构好还是 P 结构好？
    sum_An_Q = 0;
    sum_An_P = 0;
    
    for k = 1:length(all_members_An)
        o = all_members_An(k); % 合作伙伴 o
        
        % 找出 o 在 Q 和 P 中分别参与了哪些任务
        tasks_o_Q = find(cellfun(@(x) any(x(o, :) > 0), SC_Q));
        tasks_o_P = find(cellfun(@(x) any(x(o, :) > 0), SC_P));
        
        % 累加 o 在 Q 结构下的总效用
        sum_An_Q = sum_An_Q + sum_utility(o, tasks_o_Q, SC_Q, agents, tasks, Value_Params, Value_data.other{o}.initbelief);
        % 累加 o 在 P 结构下的总效用
        sum_An_P = sum_An_P + sum_utility(o, tasks_o_P, SC_P, agents, tasks, Value_Params, Value_data.other{o}.initbelief);
    end
    
    %% 7. 汇总与差值计算
    % LHS (Left Hand Side): 代表切换到 Q 的总收益潜力
    % = (n在Q的效用) + (对新队友的增益) + (所有合作伙伴在Q的总效用)
    lhs = u_n_Q + sum_new_delta + sum_An_Q;
    
    % RHS (Right Hand Side): 代表保留在 P 的总价值潜力 (或切换造成的损失基准)
    % = (n在P的效用) + (对老队友的损失) + (所有合作伙伴在P的总效用)
    rhs = u_n_P + sum_source_delta + sum_An_P;
    
    % 计算最终偏好值
    deltaU = lhs - rhs;
end

%% 辅助函数：获取某任务的所有成员
function members = get_members(SC, task_m, N)
    % 输入:
    %   SC: 联盟结构
    %   task_m: 任务索引
    %   N: 智能体总数 (此处未直接用到，但用于上下文理解)
    % 输出:
    %   members: 参与该任务的智能体 ID 列向量
    
    % 检查 SC{task_m} 中哪一行的资源投入之和大于 0
    % any(..., 2) 对行操作，find 返回行索引(即智能体ID)
    members = find(any(SC{task_m} > 0, 2))';
end

%% 辅助函数：计算某智能体在特定任务列表下的总效用
function total = sum_utility(agent, task_list, SC, agents, tasks, Value_Params, belief)
    % 输入:
    %   agent: 智能体 ID
    %   task_list: 该智能体参与的任务 ID 数组
    %   SC: 联盟结构
    %   belief: 用于计算效用的信念 (Belief)
    % 输出:
    %   total: 效用总和
    
    total = 0;
    for idx = 1:length(task_list)
        % 调用底层函数 overlap_coalition_self_utility 计算单个任务的效用并累加
        total = total + overlap_coalition_self_utility(agent, task_list(idx), SC, agents, tasks, Value_Params, belief);
    end
end